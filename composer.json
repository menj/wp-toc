{
    "name": "menj/wp-toc",
    "description": "WP TOC: server-side table of contents shortcode for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "MENJ",
            "homepage": "https://menj.blog"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "install-wp": "bin/install-wp-core.sh",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './.cache/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": [
            "@install-wp",
            "phpunit"
        ],
        "test-guard": "php tests/php-version-guard.php"
    },
    "scripts-descriptions": {
        "install-wp": "Download the WordPress core files the tests need.",
        "test": "Run the PHPUnit tests.",
        "test-guard": "Check that WP TOC refuses to load on PHP below 8.4 (run with an old PHP)."
    }
}
